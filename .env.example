# PostgreSQL (ใช้ host.docker.internal แทน localhost เมื่อรันใน Docker)
DATABASE_URL=postgresql+asyncpg://llm_user:llm_pass@localhost:5432/llm_translate_db
DB_SCHEMA=llm_translate
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

# Local LLM (OpenAI-compatible API)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SEC=120
LLM_MAX_CONCURRENT=2

# Cache
CACHE_MAX_ENTRIES=10000
CACHE_EVICTION_BATCH=500

# Application
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false
APP_ENV=development
LOG_LEVEL=INFO
MESSAGE_MAX_LENGTH=32000
SSE_PAD_BYTES=512

# Default prompts (fallback when DB is empty)
DEFAULT_SYSTEM_PROMPT=You are a professional translator. Preserve meaning and tone. Output only the translation, never explanations or extra text.
DEFAULT_INSTRUCTION_PROMPT=Translate the user message from the source language to the target language. Supported languages: en (English), zh (Chinese), th (Thai). Respond with the translated text only.
DEFAULT_PERSONA_PROMPT=Use a neutral, concise tone suitable for everyday conversation.
